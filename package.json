{
  "name": "runflow-js",
  "version": "0.0.0",
  "private": true,
  "description": "The JavaScript surface for Runflow — SDK, embeddable Studio, and server proxy.",
  "license": "MIT",
  "homepage": "https://github.com/runflow-io/runflow-js",
  "repository": {
    "type": "git",
    "url": "https://github.com/runflow-io/runflow-js.git"
  },
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "build": "cd packages/sdk && bun run build && cd ../proxy && bun run build && cd ../studio && bun run build",
    "test": "bun run --filter='./packages/*' test",
    "typecheck": "bun run --filter='./packages/*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "clean": "bun run --filter='./packages/*' clean && rm -rf node_modules .turbo",
    "changeset": "changeset",
    "release": "bun run build && changeset publish",
    "proof": "bun run examples/e2e-proof/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.10",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.1"
  },
  "packageManager": "bun@1.3.10"
}
