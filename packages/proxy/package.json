{
  "name": "@runflow-io/proxy",
  "version": "0.1.0",
  "description": "Web Standards proxy handler for forwarding browser calls to the Runflow API with your secret key server-side.",
  "license": "MIT",
  "homepage": "https://github.com/runflow-io/runflow-js/tree/main/packages/proxy#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/runflow-io/runflow-js.git",
    "directory": "packages/proxy"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
